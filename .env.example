# Tatum Sui gRPC (all chain reads and writes). Without it Sibyl falls back to the public fullnode.
TATUM_API_KEY=

# Networks: voices read DeepBook on mainnet; anchors, payments and trades go to testnet by default.
SUI_READ_NETWORK=mainnet
SUI_WRITE_NETWORK=testnet

# Walrus Memory (always mainnet). Missing values = MOCK MEMORY.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Optional: write to e.g. "sibyl-dev:*" namespaces during tests.
MEMORY_NAMESPACE=sibyl

# Wallets (write network). Trader anchors and trades; buyer pays analysts; recipient is paid.
TRADER_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
ANALYST_RECIPIENT_ADDRESS=
# Random 32 bytes (openssl rand -hex 32), binds MPP challenges to their contents.
MPP_SECRET_KEY=
# From `pnpm publish:move`.
SIBYL_PACKAGE_ID=

ENABLE_POLYMARKET=false

# off | dry | live   (live needs the keys above; defaults never move funds)
PAYMENTS_MODE=dry
# off | paper | live
TRADE_MODE=paper
# off | dry | live
ANCHOR_MODE=dry

MAX_STAKE_USDC=1
MAX_DAILY_USDC=20
MAX_PAYMENT_USDC=0.05
MAX_DAILY_PAYMENTS_USDC=3
# value (memory decides what to buy) | always (buy every analyst, within the caps)
BUY_POLICY=value

PORT=8787
DB_PATH=./data/sibyl.db
